{
  "name": "warframe-market-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit && node scripts/check-architecture.mjs",
    "test": "pnpm build && node --test test/*.test.mjs",
    "check": "pnpm lint && pnpm test && node scripts/audit-publication.mjs",
    "audit:publication": "node scripts/audit-publication.mjs",
    "dev:fixtures": "pnpm build && DATA_SOURCE=fixtures node dist/main.js"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.15.0"
  },
  "private": true,
  "description": "Read-only Warframe Market catalog search and orders API",
  "engines": {
    "node": ">=24 <26"
  },
  "packageManager": "pnpm@10.18.3"
}
